# ─────────────────────────────────────────────────────────────────────────────
# Insurio — environment configuration
#
# Local development: copy to backend/.env (the API reads .env from its workdir
# or the parent directory). Docker Compose: copy to .env at the repository root.
#
# MANDATORY IN PRODUCTION: SECRET_KEY, DATABASE_URL, CORS_ORIGINS.
# REQUIRED FOR AI ANSWERS: GROQ_API_KEY.
# NEVER commit a real .env file. Only this example is tracked.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
# development | test | production
# production disables /docs, /redoc, /openapi.json and rejects the default secret.
APP_ENV=development
APP_NAME=Insurio API
APP_VERSION=2.0.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Frontend origin used by product links (informational).
FRONTEND_URL=http://localhost:3000

# ── Security ─────────────────────────────────────────────────────────────────
# MUST be replaced. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Startup fails in production if this is left at the built-in default.
SECRET_KEY=local-compose-secret-change-before-deploying-0123456789
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_EXPIRE_MINUTES=30

# Comma-separated browser origins allowed to call the API. No wildcards.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Local PostgreSQL:
#   DATABASE_URL=postgresql+psycopg://insurio:insurio@localhost:5432/insurio
# Docker Compose (service name is the host):
#   DATABASE_URL=postgresql+psycopg://insurio:insurio@db:5432/insurio
# SQLite is supported for tests/offline demos only:
#   DATABASE_URL=sqlite+pysqlite:///./insurio.db
DATABASE_URL=postgresql+psycopg://insurio:insurio@localhost:5432/insurio
DB_ECHO=false

# ── Uploads and extraction ───────────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=400
# Requires the tesseract-ocr binary and requirements-ml.txt extras.
OCR_ENABLED=false

# ── Groq (AI answers and insight enrichment) ─────────────────────────────────
# Create a key at https://console.groq.com/keys. Without it, upload, extraction,
# insights, comparison and history work; chat returns an explicit 503.
GROQ_API_KEY=
# Must be a model currently served by Groq — check https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1400

# Use the LLM to enrich deterministic field extraction (quotes are still verified).
INSIGHTS_LLM_ENRICHMENT=true

# ── Retrieval and embeddings ─────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=24
RETRIEVAL_MIN_SCORE=0.0
EMBEDDINGS_ENABLED=true
# auto | fastembed | sentence-transformers | hashing | none
# auto selects fastembed (ONNX, 384d) then sentence-transformers, else BM25-only.
# "hashing" is deterministic and intended for tests/offline use only.
# "none" forces lexical BM25 retrieval (no model download, still functional).
EMBEDDING_PROVIDER=auto
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# ── Abuse control (per API process) ──────────────────────────────────────────
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_MINUTE=30
UPLOAD_RATE_LIMIT_PER_HOUR=20

# 0 = unlimited. Used only for the usage display.
PLAN_QUESTION_QUOTA=0

# ── Docker Compose only ──────────────────────────────────────────────────────
# These are consumed by docker-compose.yml, not by the API itself.
POSTGRES_USER=insurio
POSTGRES_PASSWORD=insurio
POSTGRES_DB=insurio
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
# Must be reachable from the browser. Change for any non-local deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
